# Dashboard-only interactive startup. The outer login shell already read profiles.
[[ -r ~/.bashrc ]] && source ~/.bashrc
if ! declare -F _completion_loader >/dev/null && [[ -r /usr/share/bash-completion/bash_completion ]]; then
  source /usr/share/bash-completion/bash_completion
fi
bind 'set show-all-if-ambiguous on'
bind 'set completion-ignore-case on'
bind '"\t":menu-complete'
bind '"\e[Z":menu-complete-backward'
__jd_prompt() {
  PS1='\[\e[36m\]\w\[\e[0m\]\n\[\e[36m\]❯\[\e[0m\] '
}
PROMPT_COMMAND+=(__jd_prompt)
__jd_prompt
