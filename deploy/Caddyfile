# Single origin for the dashboard.
#
# Serving the UI and the API from one origin is not cosmetic: the session
# cookie is SameSite=Strict and the API refuses cross-origin WebSocket
# upgrades, so a split origin would break both by design.
#
# This is the only listener in the stack bound to anything but loopback, which
# makes it the single place where "who can reach the dashboard" is decided.
{
	admin off
	# Disable only the redirect listener — certificate management stays on,
	# because `tls internal` below depends on it.
	auto_https disable_redirects
}

# JD_SITE is the address you actually type into the browser — your Tailscale
# address, a WireGuard address such as 10.8.0.1, or localhost. It is both an
# address Caddy binds and a name its certificate is issued for, so those two
# can never drift apart.
#
# Loopback is listed alongside it unconditionally, which is what makes an SSH
# tunnel work no matter how the dashboard is configured. That is not a second
# way in: reaching loopback requires an SSH session on this machine, and
# anyone with one already has root. What it buys is that Tailscale being down,
# or a key expiring, costs you a tunnel command rather than your dashboard.
# When JD_SITE is already localhost, Caddy collapses the two into one.
#
# The three ports are variables because the defaults are the three most
# contested numbers on a Linux server: 3000 is every Node app ever started,
# 8080 is every second Java or Go service, and 8443 is the obvious alternative
# HTTPS port. A machine that already runs something on one of them is the
# normal case, not the exotic one — and the failure it used to produce was the
# worst kind, because Caddy would come up clean and proxy the operator
# straight to whatever already held the port. The dashboard looked broken in a
# way that pointed at nothing. Set JD_PORT, JD_FRONTEND_PORT or
# JD_BACKEND_PORT in .env and every file that needs the number reads it from
# there; install.sh picks free ones on a machine where the defaults are taken.
{$JD_SITE:localhost}:{$JD_PORT:8443}, localhost:{$JD_PORT:8443} {
	# The site addresses above decide which Host/SNI this block answers for --
	# they do NOT decide which interfaces the socket binds. Without an explicit
	# bind, Caddy listens on every interface, so JD_SITE=localhost would
	# still leave a root-equivalent dashboard on a public port, defended only
	# by whatever the host firewall happens to be doing. Binding the same
	# values keeps the two in step: the site address binds only its own
	# interface, and loopback stays loopback.
	bind {$JD_SITE:localhost} localhost

	# Caddy's own CA signs this. It is enough because the listener is only ever
	# reached over a VPN tunnel or an SSH forward, both already encrypted and
	# authenticated — the browser warns once and you accept it once.
	# Replace with `tls <cert> <key>` to use your own certificate.
	tls internal

	encode zstd gzip

	# The API, including every WebSocket endpoint. Caddy upgrades these
	# transparently, which is why production needs no NEXT_PUBLIC_WS_BASE.
	handle /api/* {
		reverse_proxy 127.0.0.1:{$JD_BACKEND_PORT:8080} {
			# The backend only trusts a forwarded address from a proxy listed
			# in JD_TRUSTED_PROXIES; without that pairing its allowlist
			# would judge every request by this proxy's address instead of the
			# real client's.
			header_up X-Forwarded-For {remote_host}
			# Long-lived streams: metrics push, log tails, PTY sessions.
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:{$JD_BACKEND_PORT:8080}
	}

	handle {
		reverse_proxy 127.0.0.1:{$JD_FRONTEND_PORT:3000}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
